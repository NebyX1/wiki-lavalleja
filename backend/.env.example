# ============================================================
# WikiLavalleja Backend
# Example environment configuration. Copy to .env and edit.
#   cp .env.example .env        (Linux/Mac)
#   copy .env.example .env      (Windows)
# DO NOT commit your real .env file.
# ============================================================

# --- Flask Settings ---
FLASK_APP=wsgi.py
FLASK_ENV=production
FLASK_CONFIG=production
FLASK_DEBUG=0
FLASK_RUN_HOST=0.0.0.0
FLASK_RUN_PORT=5000

# Generate with: flask rotate-secret
SECRET_KEY=change-me-to-a-long-random-secret-key
WTF_CSRF_SECRET_KEY=change-me-to-another-long-random-secret-key

# --- Application URLs ---
APP_BASE_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=mariadb+mariadbconnector://user:password@localhost:3306/wikilavalleja

# --- Mail (SMTP) ---
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=no-reply@example.com
MAIL_PASSWORD=change-me
MAIL_DEFAULT_SENDER=no-reply@example.com

# --- MinIO (Object Storage) ---
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=change-me
MINIO_SECRET_KEY=change-me
MINIO_SECURE=False
MINIO_BUCKET_NAME=wikilavalleja-media
MINIO_PRESIGNED_EXPIRY=3600

# --- Media Processing ---
WIKI_MEDIA_MAX_BYTES=10485760
WIKI_MEDIA_MAX_WIDTH=12000
WIKI_MEDIA_MAX_HEIGHT=12000
WIKI_MEDIA_WEBP_QUALITY=85
WIKI_MEDIA_SMALL_WIDTH=480
WIKI_MEDIA_MEDIUM_WIDTH=960
WIKI_MEDIA_LARGE_WIDTH=1600

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- CORS ---
CORS_ORIGINS=http://localhost:5173

# --- 2FA Security ---
ENABLE_2FA_CODE_LOGGING=False
MAX_2FA_ATTEMPTS=5
SESSION_LIFETIME_MINUTES=480

# --- OpenAPI ---
OPENAPI_ENABLED=True

# --- Logging ---
LOG_FORMAT=%(asctime)s [%(levelname)s] %(module)s: %(message)s

# --- Required Services in Production ---
REQUIRE_REDIS_IN_PRODUCTION=False
REQUIRE_MINIO_IN_PRODUCTION=False

# --- Gunicorn ---
PORT=5000
GUNICORN_WORKERS=4
GUNICORN_THREADS=4
GUNICORN_TIMEOUT=60
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5
GUNICORN_MAX_REQUESTS=1000
GUNICORN_MAX_REQUESTS_JITTER=100
GUNICORN_LOG_LEVEL=info